%% luuna-beacon — service architecture
%%
%% Renders inline on GitHub or via a Mermaid CLI.
%% docs/architecture.mmd -o docs/architecture.png`. The diagram is the
%% canonical answer to "how does luuna-beacon resolve a prompt end to end?".
%% Keep it boring; the goal is to orient an agent in 30 seconds.

flowchart LR
    user["Agent / Human"]
    cli["luuna-beacon CLI\n(cmd/luuna-beacon)"]
    cmds["Command handlers\n(internal/cli)"]
    render["Render engine\n(internal/cli)"]
    validate["Schema validator\n(internal/cli)"]
    store["JSONL store\n(.luuna/beacon/prompts.jsonl)"]
    emitted["Emitted prompts\n(*.md / *.ts on disk)"]

    user -->|"invokes"| cli
    cli -->|"dispatches"| cmds
    cmds -->|"read / append"| store
    cmds -->|"resolve inheritance"| render
    cmds -->|"check against schemas.jsonl"| validate
    render -->|"merge sections"| emitted

    classDef io fill:#e2e8f0,stroke:#334155,stroke-width:1px,color:#0f172a;
    classDef component fill:#f8fafc,stroke:#0f172a,stroke-width:1px,color:#0f172a;
    classDef storage fill:#fefce8,stroke:#854d0e,stroke-width:1px,color:#0f172a;
    class user,emitted io;
    class cli,cmds,render,validate component;
    class store storage;

%% --- Sequence: `luuna-beacon emit <name>` (the hot path) -------------------------
%% 1. User runs `luuna-beacon emit <name>` from a project containing `.luuna/beacon/`.
%% 2. `internal/cli` parses global flags (`--json`, `--quiet`, …) and dispatches emit.
%% 3. It reads project state through `internal/store` (advisory locks and atomic writes).
%% 4. `internal/cli` resolves the prompt's inheritance chain (last-write
%%    wins per section name) into a single rendered record.
%% 5. `internal/cli` enforces the prompt's `schema` (if any) against
%%    `.luuna/beacon/schemas.jsonl`.
%% 6. The emit handler writes the rendered prompt to the configured target
%%    directory (`.md` by default, `.ts` if `emitAs` ends in `.ts`).
%% 7. Downstream tools (the Luuna runtime, desktop and terminal client, or other orchestrators) consume the emitted
%%    files; luuna-beacon itself never reads them back.
